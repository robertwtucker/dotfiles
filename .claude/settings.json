{
  "permissions": {
    "allow": [
      "Edit(~/vault/**)",
      "Bash(cat ~/vault/**)",
      "Bash(ls ~/vault/**)",
      "Bash(find ~/vault/**)",
      "Bash(mkdir -p ~/vault/**)",
      "Bash(mv ~/vault/**)",
      "Bash(cp ~/vault/**)",
      "Bash(kubectl get *)",
      "Bash(pnpm outdated *)",
      "mcp__para-vault__*",
      "mcp__obsidian__*"
    ],
    "deny": ["Bash(rm -rf ~/vault*)", "Read(./.env*)", "Read(./secrets/**)"]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-notify.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/update.js notify"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/update.js prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/update.js pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/update.js post"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/update.js permreq"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/update.js stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/lifecycle.js start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/node/26.5.0/bin/node /Users/robert/.claude/statusbar/lifecycle.js end"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "high",
  "editorMode": "vim",
  "tui": "fullscreen"
}
